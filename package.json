{
  "name": "image-blaster-workspace",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=app",
    "build": "npm run build --workspace=app",
    "preview": "npm run preview --workspace=app",
    "test": "node --test tests/*.test.mjs && npm run test --workspace=app",
    "typecheck": "npm run typecheck --workspace=app",
    "engine": "node engine/cli.mjs",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
